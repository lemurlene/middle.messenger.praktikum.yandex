<div class="input {{#if isTextarea}}input--textarea{{/if}}">
  <label class="input__label">
    {{#if label}}
      <span class="input__text">{{label}}</span>
    {{/if}}

    {{#if isTextarea}}
      <textarea
        class="input__control"
        name="{{name}}"
        rows="{{rows}}"
        placeholder="{{placeholder}}"
        autocomplete="{{autocomplete}}"
      >{{#if value}}{{value}}{{/if}}</textarea>
    {{else}}
      <input
        class="input__control"
        type="{{type}}"
        name="{{name}}"
        placeholder="{{placeholder}}"
        autocomplete="{{autocomplete}}"
        {{#if value}}value="{{value}}"{{/if}}
      />
    {{/if}}
  </label>

  <span class="input__error" aria-live="polite"></span>
</div>
